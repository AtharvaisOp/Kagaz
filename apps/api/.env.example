PORT=4000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Optional native executable paths; Docker supplies gs and qpdf on PATH.
# On Windows use the Ghostscript console executable (gswin64c.exe).
GHOSTSCRIPT_PATH=gs
QPDF_PATH=qpdf
# OCRmyPDF locates Tesseract/Ghostscript on PATH. Only English data is required.
OCRMYPDF_PATH=ocrmypdf
# Python with pikepdf/PDFMiner/Pillow for all PDF and Office inspectors.
OCR_PYTHON_PATH=python3
# Office conversion requires Linux/libseccomp. Call the ELF binary directly, no shell launcher.
LIBREOFFICE_PATH=/usr/lib/libreoffice/program/oosplash

# Remote AI is disabled by default. The product supports Groq Free Plan only.
ASSISTANT_ENABLED=false
# Must be explicitly set to groq-free after the owner verifies the Groq org plan.
ASSISTANT_PROVIDER_MODE=disabled
ASSISTANT_FREE_PLAN_CONFIRMED=false
# Keep the legacy paid-budget switch false. Free Plan mode requires exactly $0.
ASSISTANT_BUDGET_CONFIRMED=false
# No paid provider spend is permitted for Kagaz.
ASSISTANT_DAILY_BUDGET_USD=0
FIREBASE_PROJECT_ID=
# Server secret: service-account JSON for that exact project, or use ADC through
# GOOGLE_APPLICATION_CREDENTIALS. Never use VITE_ for these credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
GROQ_API_KEY=
# Fixed production model: openai/gpt-oss-20b. Browser cannot override the model.
# HTTPS is mandatory; this opt-in allows only nonproduction loopback emulator tests.
ASSISTANT_ALLOW_LOCAL_HTTP=false
