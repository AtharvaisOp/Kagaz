# Production API origin. Empty uses the same origin (Vite proxies /tools locally).
VITE_API_URL=

# Firebase Web App public configuration. Missing values keep AI Chat unavailable.
# Enable only Google sign-in and authorize the production/localhost domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Development only; loopback hosts only. Never used by a production build.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
