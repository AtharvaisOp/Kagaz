{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["VITE_API_URL"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "passThroughEnv": [
        "PORT",
        "CORS_ORIGINS",
        "GHOSTSCRIPT_PATH",
        "QPDF_PATH",
        "OCRMYPDF_PATH",
        "OCR_PYTHON_PATH",
        "LIBREOFFICE_PATH",
        "VITE_API_URL"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": [
        "GHOSTSCRIPT_PATH",
        "QPDF_PATH",
        "OCRMYPDF_PATH",
        "OCR_PYTHON_PATH",
        "LIBREOFFICE_PATH"
      ],
      "outputs": []
    }
  }
}
