rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quotas, active reservations, request receipts and daily application budgets
    // contain operational metadata only. The Express API accesses them through
    // the Admin SDK and IAM. No browser requires direct database access, even
    // to its own usage record: verified usage is returned by the API instead.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
